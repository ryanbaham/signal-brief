@page "/"
@page "/issue/{IssueDate}"
@inject NewsletterDataService Newsletters
@inject DeploymentInfoService DeploymentInfo
@inject IJSRuntime JavaScript

<PageTitle>@PageTitle</PageTitle>

@if (_isLoading)
{
    <main class="newsletter-shell loading-shell">
        <section class="loading-panel" aria-live="polite">
            <p class="section-kicker">Signal Brief</p>
            <h1>@_loadingHeading</h1>
        </section>
    </main>
}
else if (_issue is null)
{
    <main class="newsletter-shell">
        <section class="empty-state">
            <p class="section-kicker">Issue unavailable</p>
            <h1>No newsletter JSON was found.</h1>
            <p>@_errorMessage</p>
            <a class="text-link" href="/">Return to the latest brief</a>
        </section>
    </main>
}
else
{
    <main class="newsletter-shell">
        <header class="masthead" aria-label="Newsletter masthead">
            <div>
                <a class="brand-lockup" href="/">@_issue.NewsletterTitle</a>
            </div>
            <div class="issue-meta">
                <p class="edition-label">@_issue.EditionLabel</p>
                <button type="button"
                        class="issue-date issue-date-trigger"
                        aria-controls="archive-panel"
                        aria-expanded="@(_isArchiveOpen ? "true" : "false")"
                        @onclick="ToggleArchiveControls">
                    <span>@_issue.IssueDate</span>
                    @if (IsLatestIssue)
                    {
                        <span class="latest-badge">Latest</span>
                    }
                </button>
            </div>
        </header>

        <section id="archive-panel"
                 class="@ArchiveSectionClass"
                 aria-label="Newsletter archive navigation"
                 aria-hidden="@(_isArchiveOpen ? "false" : "true")">
            <div class="archive-section-clip">
                <div class="archive-card">
                    <div class="archive-actions">
                        <div class="archive-summary">
                            <p class="section-kicker">Archive</p>
                            <p class="archive-current">@ArchiveLabel</p>
                        </div>

                        @if (_olderIssue is not null)
                        {
                            <a class="pager-link" href="@IssueHref(_olderIssue.Date)" tabindex="@ArchiveControlTabIndex">Older</a>
                        }
                        else
                        {
                            <span class="pager-link disabled" aria-disabled="true">Older</span>
                        }

                        @if (_newerIssue is not null)
                        {
                            <a class="pager-link" href="@IssueHref(_newerIssue.Date)" tabindex="@ArchiveControlTabIndex">Newer</a>
                        }
                        else
                        {
                            <span class="pager-link disabled" aria-disabled="true">Newer</span>
                        }
                    </div>
                </div>
            </div>
        </section>

        <section class="tldr-panel" aria-labelledby="tldr-heading">
            <p class="section-kicker">TL;DR</p>
            <h1 id="tldr-heading" class="section-title">@_issue.TldrHeading</h1>
            <ul class="tldr-list">
                @foreach (var item in _issue.TldrItems)
                {
                    <li>@item</li>
                }
            </ul>
        </section>

        <article class="featured">
            <div class="featured-media">
                <img src="@_issue.Featured.ImageUrl" alt="@_issue.Featured.ImageAlt">
            </div>
            <div class="featured-body">
                <p class="section-kicker">@_issue.Featured.Kicker</p>
                <h2 class="featured-title">@_issue.Featured.Title</h2>
                <p class="featured-summary">@_issue.Featured.Summary</p>
            </div>
            <div class="featured-copy article-body">
                @foreach (var paragraph in _issue.Featured.BodyParagraphs)
                {
                    <p>@paragraph</p>
                }
            </div>
            <div class="article-meta featured-meta" aria-label="Featured article metadata">
                @if (!string.IsNullOrWhiteSpace(_issue.Featured.ReadTime))
                {
                    <span>@_issue.Featured.ReadTime</span>
                }
                @if (!string.IsNullOrWhiteSpace(_issue.Featured.Category))
                {
                    <span>@_issue.Featured.Category</span>
                }
                @if (!string.IsNullOrWhiteSpace(_issue.Featured.Date))
                {
                    <span>@_issue.Featured.Date</span>
                }
            </div>
        </article>

        <section class="article-section" aria-labelledby="latest-stories">
            <div class="section-header">
                <div>
                    <p class="section-kicker">@_issue.ArticleSectionKicker</p>
                    <h2 id="latest-stories" class="section-title">@_issue.ArticleSectionTitle</h2>
                </div>
            </div>

            <div class="article-grid">
                @foreach (var article in _issue.Articles)
                {
                    <article class="article-card">
                        <img src="@article.ImageUrl" alt="@article.ImageAlt">
                        <div class="article-card-body">
                            <p class="article-tag">@article.Category</p>
                            <h3 class="article-title">@article.Title</h3>
                            <p class="article-summary">@article.Summary</p>
                            <div class="article-body">
                                @foreach (var paragraph in article.BodyParagraphs)
                                {
                                    <p>@paragraph</p>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>

        <footer class="footer-note">
            <span>@_issue.FooterNote</span>
            @if (_deployment is not null)
            {
                <span class="deployment-stamp" title="@_deployment.LocalTime" tabindex="0">
                    Deployed @_deployment.DisplayDate
                </span>
            }
        </footer>
    </main>
}

@code {
    [Parameter]
    public string? IssueDate { get; set; }

    private NewsletterIndex _index = new();
    private NewsletterIssue? _issue;
    private NewsletterIndexItem? _newerIssue;
    private NewsletterIndexItem? _olderIssue;
    private DeploymentDisplayInfo? _deployment;
    private bool _isLoading = true;
    private bool _isArchiveOpen;
    private string? _errorMessage;
    private string? _currentIssueDate;
    private string _loadingHeading = DefaultLoadingHeading;
    private const string DefaultLoadingHeading = "Tuning the signal.";

    private string PageTitle => _issue is null ? "Signal Brief" : $"{_issue.NewsletterTitle} - {_issue.IssueDate}";
    private string? LatestIssueDate => string.IsNullOrWhiteSpace(_index.LatestDate) ? _index.Issues.FirstOrDefault()?.Date : _index.LatestDate;
    private bool IsLatestIssue => string.Equals(_currentIssueDate, LatestIssueDate, StringComparison.OrdinalIgnoreCase);
    private string ArchiveSectionClass => _isArchiveOpen ? "archive-section is-open" : "archive-section";
    private string? ArchiveControlTabIndex => _isArchiveOpen ? null : "-1";

    private string ArchiveLabel => _index.Issues.Count switch
    {
        0 => "No issues available",
        1 => "1 issue available",
        _ => $"{_index.Issues.Count} issues available"
    };

    protected override void OnInitialized()
    {
        _loadingHeading = GetBrowserLoadingHeading();
    }

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _issue = null;
        _currentIssueDate = null;
        _isArchiveOpen = false;
        _loadingHeading = GetBrowserLoadingHeading();

        try
        {
            _deployment = await DeploymentInfo.GetDisplayInfoAsync();
            _index = await Newsletters.GetIndexAsync();
            var targetDate = string.IsNullOrWhiteSpace(IssueDate) ? _index.LatestDate : IssueDate;

            if (string.IsNullOrWhiteSpace(targetDate))
            {
                _errorMessage = "The newsletter index did not identify a latest issue.";
                return;
            }

            _issue = await Newsletters.GetIssueAsync(targetDate);
            _currentIssueDate = targetDate;
            SetArchiveNeighbors(targetDate);

            if (_issue is null)
            {
                _errorMessage = $"No issue exists for {targetDate}.";
            }
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SetArchiveNeighbors(string targetDate)
    {
        _newerIssue = null;
        _olderIssue = null;

        var issues = _index.Issues;
        var currentIndex = issues.FindIndex(issue => string.Equals(issue.Date, targetDate, StringComparison.OrdinalIgnoreCase));

        if (currentIndex < 0)
        {
            return;
        }

        _newerIssue = currentIndex > 0 ? issues[currentIndex - 1] : null;
        _olderIssue = currentIndex < issues.Count - 1 ? issues[currentIndex + 1] : null;
    }

    private static string IssueHref(string issueDate)
    {
        return $"/issue/{Uri.EscapeDataString(issueDate)}";
    }

    private void ToggleArchiveControls()
    {
        _isArchiveOpen = !_isArchiveOpen;
    }

    private string GetBrowserLoadingHeading()
    {
        try
        {
            if (JavaScript is IJSInProcessRuntime inProcessRuntime)
            {
                return inProcessRuntime.Invoke<string>("signalBriefLoading.getHeading") ?? DefaultLoadingHeading;
            }
        }
        catch (JSException)
        {
            return DefaultLoadingHeading;
        }

        return DefaultLoadingHeading;
    }
}
