{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/_framework/*",
      "/css/*",
      "/newsletters/*",
      "/*.{png,jpg,jpeg,gif,ico,svg,webp,json,wasm,dll,pdb,dat}"
    ]
  },
  "platform": {
    "apiRuntime": "dotnet-isolated:9.0"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}
